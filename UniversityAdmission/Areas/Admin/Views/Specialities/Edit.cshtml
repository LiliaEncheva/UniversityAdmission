@model UniversityAdmission.Areas.Admin.ViewModels.SpecialityViewModel

@{
    ViewData["Title"] = "Редактирай специалност";
}

<h2>Редактирай специалност</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-2">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Seats" class="form-label"></label>
        <input asp-for="Seats" class="form-control" type="number" min="0" />
        <span asp-validation-for="Seats" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Откажи</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
