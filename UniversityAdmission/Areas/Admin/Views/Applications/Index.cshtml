@model UniversityAdmission.Models.ApplicationsIndexViewModel

@{
    ViewData["Title"] = "Кандидатури";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Подадени кандидатури</h2>
        
        <!-- Бутон за публикуване на резултатите -->
        <form asp-area="Admin" asp-controller="Applications" asp-action="PublishResults" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success shadow-sm">
                <i class="fas fa-check-circle me-1"></i> Публикувай резултати
            </button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Студент</th>
                        <th class="text-center">Бал</th>
                        <th class="text-center">Статус</th>
                        <th>Специалности (по желание)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Applications.Any())
                    {
                        @foreach (var app in Model.Applications)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@app.User.FullName</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border p-2">
                                        @app.TotalScore.ToString("F2")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (app.Status)
                                    {
                                        case UniversityAdmission.Models.Enums.ApplicationStatus.NotAccepted:
                                            <span class="badge bg-secondary">Не е приет</span>
                                            break;
                                        case UniversityAdmission.Models.Enums.ApplicationStatus.Pending:
                                            <span class="badge bg-warning text-dark">В процес</span>
                                            break;
                                        case UniversityAdmission.Models.Enums.ApplicationStatus.Confirmed:
                                            <span class="badge bg-success">Приета</span>
                                            break;
                                        case UniversityAdmission.Models.Enums.ApplicationStatus.Rejected:
                                            <span class="badge bg-danger">Отхвърлена</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="small">
                                        @foreach (var spec in app.ApplicationSpecialities.OrderBy(x => x.PreferenceOrder))
                                        {
                                            <div class="mb-1">
                                                <span class="text-muted">@spec.PreferenceOrder.</span> @spec.Speciality.Name
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Няма намерени кандидатури.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Пагинация -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top-0">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link shadow-sm" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link shadow-sm" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link shadow-sm" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                <div class="text-center mt-2 text-muted small">
                    Показване на @Model.Applications.Count от @Model.TotalItems общо
                </div>
            </div>
        }
    </div>
</div>