@model IEnumerable<UniversityAdmission.Models.Entities.Application>

<h2>Резултати от класирането</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Кандидат</th>
            <th>Бал</th>
            <th>Специалност</th>
            <th>Ред на желание</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            foreach (var choice in app.ApplicationSpecialities.OrderBy(c => c.PreferenceOrder))
            {
                <tr>
                    <td>@app.User.FullName</td>
                    <td>@app.TotalScore</td>
                    <td>@choice.Speciality.Name</td>
                    <td>@choice.PreferenceOrder</td>
                    <td>@app.Status</td>
                </tr>
            }
        }
    </tbody>
</table>