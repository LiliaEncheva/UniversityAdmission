@model IEnumerable<UniversityAdmission.Models.Entities.Application>

<h2>Резултати от класирането</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Кандидат</th>
            <th>Бал</th>
            <th>Специалност</th>
            <th>Ред на желание</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model.OrderByDescending(a => a.TotalScore))
        {
            var admitted = app.ApplicationSpecialities.FirstOrDefault(c => c.IsAdmitted);
            <tr>
                <td>@app.User.FullName</td>
                <td>@app.TotalScore</td>
                <td>@(admitted != null ? admitted.Speciality.Name : "—")</td>
                <td>@(admitted != null ? admitted.PreferenceOrder.ToString() : "—")</td>
                <td>@(admitted != null ? "Приет" : "Не е приет")</td>
            </tr>
        }
    </tbody>
</table>