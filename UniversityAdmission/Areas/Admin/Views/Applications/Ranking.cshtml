@model UniversityAdmission.Models.RankingViewModel

@{
    ViewData["Title"] = "Резултати от класирането";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="admin-title mb-0">Резултати от класирането</h2>
        <form asp-action="PublishResults" method="post">
            <button type="submit" class="btn btn-primary btn-sm">
                🔄 Преизчисли и Публикувай
            </button>
        </form>
    </div>

    <!-- Филтри -->
    <div class="card admin-card mb-4">
        <div class="card-header admin-card-header">
            🔍 Филтриране
        </div>
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small">Специалност</label>
                    <select name="specialityId" asp-for="SpecialityId" asp-items="Model.Specialities" class="form-select form-select-sm">
                        <option value="">Всички специалности</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Ред на желание</label>
                    <select name="preferenceOrder" asp-for="PreferenceOrder" class="form-select form-select-sm">
                        <option value="">Всички желания</option>
                        @for (int i = 1; i <= 3; i++)
                        {
                            <option value="@i">@i-ро желание</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Статус</label>
                    <select name="status" asp-for="Status" asp-items="Model.Statuses" class="form-select form-select-sm">
                        <option value="">Всички статуси</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                        Филтрирай
                    </button>
                    <a asp-action="Ranking" class="btn btn-outline-secondary btn-sm">
                        ❌
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Таблица с резултати -->
    <div class="card admin-card">
        <div class="card-header admin-card-header">
            📋 Списък с кандидати
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Кандидат</th>
                            <th class="text-center">Бал</th>
                            <th>Специалност</th>
                            <th class="text-center">Желание</th>
                            <th class="text-center">Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Applications.Any())
                        {
                            int index = (Model.CurrentPage - 1) * 10 + 1;
                            foreach (var app in Model.Applications)
                            {
                                var admitted = app.ApplicationSpecialities.FirstOrDefault(c => c.IsAdmitted);
                                <tr>
                                    <td class="ps-3 text-muted">@index</td>
                                    <td>
                                        <div class="fw-bold">@app.User.FullName</div>
                                        <div class="small text-muted">@app.User.Email</div>
                                    </td>
                                    <td class="text-center fw-bold text-primary">@app.TotalScore.ToString("F2")</td>
                                    <td>
                                        @if (admitted != null)
                                        {
                                            <span>@admitted.Speciality.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (admitted != null)
                                        {
                                            <span>@admitted.PreferenceOrder</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (admitted != null)
                                        {
                                            <span class="badge bg-success">Приет</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Не е приет</span>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Няма намерени резултати за избраните филтри.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Ranking" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-specialityId="@Model.SpecialityId"
                       asp-route-preferenceOrder="@Model.PreferenceOrder"
                       asp-route-status="@Model.Status">
                        Предишна
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Ranking" 
                           asp-route-page="@i"
                           asp-route-specialityId="@Model.SpecialityId"
                           asp-route-preferenceOrder="@Model.PreferenceOrder"
                           asp-route-status="@Model.Status">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Ranking" 
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-specialityId="@Model.SpecialityId"
                       asp-route-preferenceOrder="@Model.PreferenceOrder"
                       asp-route-status="@Model.Status">
                        Следваща
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .pagination .page-link {
        color: #0d6efd;
        border: none;
        margin: 0 2px;
        border-radius: 5px;
    }
    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        color: white;
    }
    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }
</style>